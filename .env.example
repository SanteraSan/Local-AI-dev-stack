# Copy to .env and fill in. Never commit .env.
# Generate secrets: openssl rand -hex 32

# Postgres + pgvector (127.0.0.1:5442)
PG_PASSWORD=

# LiteLLM gateway (127.0.0.1:4000)
LITELLM_MASTER_KEY=sk-
LITELLM_DATABASE_URL=postgresql://devai:CHANGE_ME@127.0.0.1:5442/litellm

# External providers for *-cloud fallback aliases (optional)
OPENROUTER_API_KEY=

# Virtual keys issued by LiteLLM for clients: ./litellm/issue-keys.sh
LITELLM_OPENWEBUI_KEY=
LITELLM_CONTINUE_KEY=
LITELLM_ROO_KEY=
LITELLM_OPENCODE_KEY=
LITELLM_TASKFLOW_KEY=
LITELLM_DEVMEM_KEY=

# devmem MCP server (127.0.0.1:8765)
DEVMEM_TOKEN=
DEVMEM_DATABASE_URL=postgresql://devai:CHANGE_ME@127.0.0.1:5442/devmem

# Optional. Tool responses: json (default), toon, or csv.
DEVMEM_RESPONSE_FORMAT=json
# Optional. When empty, tests use DEVMEM_DATABASE_URL with the database name swapped to devmem_test.
DEVMEM_TEST_DATABASE_URL=
